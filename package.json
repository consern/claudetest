{
  "name": "terminal-coding-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/cli/index.js",
  "scripts": {
    "dev": "tsx src/cli/index.tsx",
    "dev:service": "tsx src/service/index.ts",
    "dev:desktop": "tsx scripts/desktop-dev.ts",
    "dev:desktop:web": "pnpm --dir desktop/app exec vite",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli/index.js",
    "start:service": "node dist/service/index.js",
    "build:desktop": "pnpm --dir desktop/app exec tsc -p tsconfig.json && pnpm --dir desktop/app exec vite build",
    "build:desktop:full": "pnpm build && pnpm build:desktop",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "diff": "^8.0.4",
    "dotenv": "^17.4.0",
    "execa": "^9.6.1",
    "fast-glob": "^3.3.3",
    "ink": "^6.8.0",
    "react": "^19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/react": "^19.2.14",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
